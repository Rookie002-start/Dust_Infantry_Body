#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/clock/hpm5361-clocks.h>
#include "dt-bindings/pinctrl/hpmicro-pinctrl-common.h"
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
    aliases {
        user-can1   = &mcan0;
        inter-can   = &mcan0;      /* 上下板通信总线（总线所有者组件用） */
        remote-uart = &uart4;
        hipnuc-uart = &uart3;
        imu-spi     = &icm42688p;
        imu-pwm     = &imu_pwm;
        buzzer-pwm  = &buzzer_pwm;
        flash-spi   = &w25q128;
        pc-usb      = &qingyuusb_usb0;
    };

    chosen {
        zephyr,console = &uart2;
        zephyr,watchdog = &ewdg0;
    };

    pwm {
        compatible = "pwm-leds";

        imu_pwm: imu_pwm {
            pwms = <&pwm0 7 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
            label = "ICM42688P Heater";
            status = "okay";
        };

        buzzer_pwm: buzzer_pwm {
            pwms = <&pwm0 5 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
            label = "Buzzer";
            status = "okay";
        };

        pwm1_p2: pwm1_p2 {
            pwms = <&pwm1 2 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
            label = "PWM1 CH2";
            status = "okay";
        };

        pwm1_p3: pwm1_p3 {
            pwms = <&pwm1 3 PWM_USEC(1000) PWM_POLARITY_NORMAL>;
            label = "PWM1 CH3";
            status = "okay";
        };
    };
};

&hdma {
    status = "okay";
};

&gpioa {
    pinctrl-0 = <&pinmux_gpioa>;
    pinctrl-names = "default";
    status = "okay";
};

&gpiob {
    pinctrl-0 = <&pinmux_gpiob_spi>;
    pinctrl-names = "default";
    status = "okay";
};

&gpioy {
    pinctrl-0 = <&pinmux_gpioy>;
    pinctrl-names = "default";
    status = "okay";
};

&mcan0 {
    pinctrl-0 = <&pinmux_mcan0_txrx>;
    pinctrl-names = "default";
    /* 位时序要精确：CAN 时钟必须能被 1Mbps 整除。
     * 原来 PLL1_CLK0(792MHz)/5 = 158.4MHz，SDK 只能取 158 tq 近似
     *   → prescaler=1, tq=158, seg1=119, seg2=39 → 实际 1.0025 Mbps（+0.25%）
     * 改成 OSC24M/1 = 24MHz：
     *   → prescaler=1, tq=24, seg1=18, seg2=6 → 精确 1.000 Mbps，采样点 75% */
    // clk-source = <CLK_SRC_OSC24M>;
    // clk-divider = <1>;
    bitrate = <1000000>;
    status = "okay";
};

&uart1 {
    /* HiPNUC IMU：PY06/PY07，115200 8N1 */
    current-speed = <115200>;
    pinctrl-0 = <&pinmux_uart1>;
    pinctrl-names = "default";
    dmas = <&hdma 6 0x16>, <&hdma 7 0x17>;
    dma-names = "rx", "tx";
    status = "okay";
};

&uart4 {
    current-speed = <100000>;
    pinctrl-0 = <&pinmux_uart4_rx>;
    pinctrl-names = "default";
    uart-idle-gptmr-reg = <0xF000C000>;
    uart-idle-gptmr-clock-name = <CLOCK_GPTMR3>;
    dmas = <&hdma 2 0x1C>, <&hdma 3 0x1D>;
    dma-names = "rx", "tx";
    status = "okay";
};

&uart3 {
    current-speed = <921600>;
    pinctrl-0 = <&pinmux_uart3>;
    pinctrl-names = "default";
    dmas = <&hdma 4 0x1A>, <&hdma 5 0x1B>;
    dma-names = "rx", "tx";
    status = "okay";
};

/* ---- UART2（console，板载 "UART2"/H4 连接器）--------------------------
 * 连接器侧：H4.1 = +5V，H4.2 = GND（TVS 到 GND，F11/F12 串在数据线上）
 *           H4.3 = 板侧 RXD，H4.4 = 板侧 TXD
 * MCU 侧 ：PB09 = UART2_RXD，PB08 = UART2_TXD（IOC ALT2）
 *
 * HPM53xx 的 SoC dtsi 里没有 uart2 节点，按 uart0/1/3/4 的写法补一个：
 *   reg 0xF0048000（HPM_UART2_BASE），IRQ 15 = UART2（IRQn_UART2）
 * 时钟用 24M OSC：115200/921600 都能整除，且不依赖 PLL1 的状态。
 */
&{/soc} {
    ewdg0: watchdog@f00b0000 {
        compatible = "hpmicro,hpm-ewdg";
        reg = <0xf00b0000 0x4000>;
        interrupts = <32 1>;
        interrupt-parent = <&plic>;
        clk-name = <CLOCK_WATCHDOG0>;
        status = "okay";
    };

    uart2: serial@f0048000 {
        compatible = "hpmicro,hpm-uart";
        reg = <0xf0048000 0x1000>;
        interrupts = <15 1>, <5 1>;
        interrupt-names = "uart", "idletimer";
        clocks = <&clk CLOCK_UART2 CLK_SRC_PLL1_CLK0 6>;
        interrupt-parent = <&plic>;
        status = "disabled";
    };
};

&pinctrl {
    pinmux_uart2: pinmux_uart2 {
        group0 {
            pinmux = <HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTB, 8), IOC_TYPE_IOC, 0, 2)>,
                     <HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTB, 9), IOC_TYPE_IOC, 0, 2)>;
            input-enable;
        };
    };
};

&uart2 {
    /* console：921600 8N1，PB08 = UART2_TXD / PB09 = UART2_RXD */
    current-speed = <921600>;
    pinctrl-0 = <&pinmux_uart2>;
    pinctrl-names = "default";
    /* 通道 0/1；0x18/0x19 = UART2_RX/TX（DMAMUX 源） */
    dmas = <&hdma 0 0x18>, <&hdma 1 0x19>;
    dma-names = "rx", "tx";
    status = "okay";
};

qingyuusb_usb0: &usb0 {
    compatible = "hpmicro,hpm-qingyuusb";
    clk-name = <CLOCK_USB0>;
    status = "okay";
};

&spi1 {
    pinctrl-0 = <&pinmux_spi1>;
    pinctrl-names = "default";
    clocks = <&clk CLOCK_SPI1 CLK_SRC_OSC24M 1>;
    status = "okay";

    w25q128: w25q128@0 {
        compatible = "winbond,w25q128";
        reg = <0>;
        spi-max-frequency = <50000000>;
        status = "okay";
    };
};

&spi2 {
    pinctrl-0 = <&pinmux_spi2_local>;
    pinctrl-names = "default";
    clocks = <&clk CLOCK_SPI2 CLK_SRC_OSC24M 1>;
    status = "okay";

    icm42688p: icm42688p@0 {
        compatible = "invensense,icm4268x";
        reg = <0>;
        spi-max-frequency = <100000>;
        int-gpios = <&gpiob 15 GPIO_ACTIVE_HIGH>;
        status = "okay";
    };
};

&pwm0 {
    pinctrl-0 = <&pinmux_pwm0_p57>;
    pinctrl-names = "default";
    period-init = <1000>;
    dead-zone-in-half-cycle = <0>;
    status = "okay";
};

&mtimer {
    compatible = "riscv,machine-timer", "andestech,machine-timer";
    reg-names = "mtime", "mtimecmp";
};

&pwm1 {
    pinctrl-0 = <&pinmux_pwm1_p23>;
    pinctrl-names = "default";
    period-init = <1000>;
    dead-zone-in-half-cycle = <0>;
    status = "okay";
};
