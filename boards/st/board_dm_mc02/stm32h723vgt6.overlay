#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/stm32-pinctrl.h>
#include <dt-bindings/dma/stm32_dma.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	aliases {
		user-can1    = &fdcan1;
		inter-can    = &fdcan2;      /* 上下板通信总线（与 head 同名，总线所有者组件用） */
		user-can3	 = &fdcan3;
		remote-uart  = &usart1;
		vofa-uart	 = &uart7;
		bmi088-accel = &bmi088_accel;
		bmi088-gyro  = &bmi088_gyro;
		imu-pwm      = &imu_pwm;
	};
	chosen {
		zephyr,console = &usart3;
		zephyr,shell-uart = &usart3;
		zephyr,watchdog = &iwdg;
	};
	leds {
		compatible = "gpio-leds";
		led_alert: led_alert {
			gpios = <&gpioc 13 GPIO_ACTIVE_LOW>;
			label = "LED_RED";
		};
	};

	pwmleds {
		compatible = "pwm-leds";

		imu_pwm: imu_pwm {
			pwms = <&pwm3 4 PWM_NSEC(2083542) PWM_POLARITY_NORMAL>;
			label = "IMU Heater";
			status = "okay";
		};
	};
};

&iwdg {
	status = "okay";
};

/* IMU 加热器 PWM：TIM3_CH4 / PB1，PSC=24，ARR=10000（≈2.0835ms，~480Hz） */
&timers3 {
	st,prescaler = <24>;
	status = "okay";

	pwm3: pwm {
		status = "okay";
		pinctrl-0 = <&tim3_ch4_pb1>;
		pinctrl-names = "default";
	};
};

&pinctrl {
	tim3_ch4_pb1: tim3_ch4_pb1 {
		pinmux = <STM32_PINMUX('B', 1, AF2)>;
	};
};

&usart1 {
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <921600>;
	dmas = <&dmamux1 0 42 (STM32_DMA_PERIPH_TX | STM32_DMA_PRIORITY_HIGH)>,
	       <&dmamux1 1 41 (STM32_DMA_PERIPH_RX | STM32_DMA_PRIORITY_HIGH)>;
	dma-names = "tx", "rx";
	status = "okay";
};

&usart3 {
	pinctrl-0 = <&usart3_tx_pb10 &usart3_rx_pb11>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&uart7 {
	pinctrl-0 = <&uart7_tx_pe8 &uart7_rx_pe7>;
	pinctrl-names = "default";
	current-speed = <921600>;
	status = "okay";
};

/* USART1 DMA（遥控器接收）：DMAMUX1 通道 0/1 映射到 DMA1 */
&dma1 {
	status = "okay";
};

&dmamux1 {
	status = "okay";
};

&fdcan1 {
	pinctrl-0 = <&fdcan1_rx_pd0 &fdcan1_tx_pd1>;
	pinctrl-names = "default";
	/* FDCAN 内核时钟源必须显式选 PLL1Q(120MHz)。
	 * 不写这一项时 RCC_D2CCIP1R.FDCANSEL 保持复位默认 = HSE(24MHz)，
	 * 而驱动仍按 DT 里 120MHz 的时钟树算位时序（120 tq/位），
	 * 结果实际位率只有标称的 1/5：1Mbps 变成 200kbps，总线上谁都收不到。 */
	clocks = <&rcc STM32_CLOCK(APB1_2, 8)>,
		 <&rcc STM32_SRC_PLL1_Q FDCAN_SEL(1)>;
	bitrate = <1000000>;
	sample-point = <800>;
	bitrate-data = <2000000>;
	sample-point-data = <750>;
	status = "okay";
};

&fdcan2 {
	pinctrl-0 = <&fdcan2_rx_pb5 &fdcan2_tx_pb6>;
	pinctrl-names = "default";
	/* 同上：内核时钟必须显式选 PLL1Q(120MHz)，否则实际位率是 1/5 */
	clocks = <&rcc STM32_CLOCK(APB1_2, 8)>,
		 <&rcc STM32_SRC_PLL1_Q FDCAN_SEL(1)>;
	bitrate = <1000000>;
	sample-point = <800>;
	bitrate-data = <4000000>;
	sample-point-data = <750>;
	status = "okay";
};

&fdcan3 {
	pinctrl-0 = <&fdcan3_rx_pd12 &fdcan3_tx_pd13>;
	pinctrl-names = "default";
	/* 同上：内核时钟必须显式选 PLL1Q(120MHz)，否则实际位率是 1/5 */
	clocks = <&rcc STM32_CLOCK(APB1_2, 8)>,
		 <&rcc STM32_SRC_PLL1_Q FDCAN_SEL(1)>;
	bitrate = <1000000>;
	status = "okay";
};

&spi2 {
	pinctrl-0 = <&spi2_sck_pb13 &spi2_miso_pc2_c &spi2_mosi_pc1>;
	pinctrl-names = "default";
	cs-gpios = <&gpioc 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
		   <&gpioc 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	/* SPI2(BMI088) DMA：DMAMUX1 通道 2/3 → DMA1 Stream2/3。
	 * 请求号 SPI2_TX=40 / SPI2_RX=39（与 SPI2 共用 0x40003800 的 i2s2 节点里给出的映射）。
	 * 通道 0/1 已给 USART1，这里错开用 2/3，务必落在 DMA1（dmamux 信道 0-7 → DMA1）。 */
	dmas = <&dmamux1 2 40 (STM32_DMA_PERIPH_TX | STM32_DMA_PRIORITY_HIGH)>,
	       <&dmamux1 3 39 (STM32_DMA_PERIPH_RX | STM32_DMA_PRIORITY_HIGH)>;
	dma-names = "tx", "rx";
	status = "okay";

	bmi088_accel: bmi088-accel@0 {
		compatible = "bosch,bmi08x-accel";
		reg = <0>;
		spi-max-frequency = <10000000>;
		spi-cpol;
		spi-cpha;
		int-gpios = <&gpioe 10 GPIO_ACTIVE_HIGH>;
		int1-map-io = <0x01>;
		int2-map-io = <0x00>;
		int1-conf-io = <0x0A>;
		int2-conf-io = <0x00>;
		accel-hz = "800";
		accel-fs = <6>;
		status = "okay";
	};

	bmi088_gyro: bmi088-gyro@1 {
		compatible = "bosch,bmi08x-gyro";
		reg = <1>;
		spi-max-frequency = <10000000>;
		spi-cpol;
		spi-cpha;
		int-gpios = <&gpioe 12 GPIO_ACTIVE_HIGH>;
		int3-4-map-io = <0x01>;
		int3-4-conf-io = <0x01>;
		gyro-hz = "2000_230";
		gyro-fs = <2000>;
		status = "okay";
	};
};
